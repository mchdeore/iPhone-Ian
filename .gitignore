# --- Secrets: never commit (see specs/00-charter.md §6) ---
.env
.env.*
secrets/
*.key
*.pem
*.secret
*.sops.yaml
*.age
vault/
credentials*.json

# --- Training data that may contain screen captures of secrets ---
datasets/
captures/
*.raw-capture

# --- Obsidian: vault is in research/.obsidian/, not repo root ---
# If you accidentally open the repo root as a vault, ignore those files
/.obsidian/

# --- Obsidian vault (research/): keep config, ignore workspace/cache ---
research/.obsidian/workspace.json
research/.obsidian/workspace-mobile.json
research/.obsidian/plugins/
research/.obsidian/themes/
research/.obsidian/*.json.bak
research/.trash/
research/.smart-env/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Python (training rig, when it exists) ---
__pycache__/
*.py[cod]
.venv/
venv/
env/

# --- Node (if any tooling) ---
node_modules/

# --- Generated CAD outputs (regenerate by running the .py files) ---
*.stl
*.step
*.3mf
