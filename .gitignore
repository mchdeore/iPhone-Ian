# --- Secrets: never commit (see specs/00-charter.md §6) ---
.env
.env.*
secrets/
*.key
*.pem
*.secret
*.sops.yaml
*.age
vault/
credentials*.json

# --- Training data that may contain screen captures of secrets ---
datasets/
captures/
*.raw-capture

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Python (training rig, when it exists) ---
__pycache__/
*.py[cod]
.venv/
venv/
env/

# --- Node (if any tooling) ---
node_modules/

# --- Generated CAD outputs (regenerate from parts/*.py) ---
parts/*.stl
parts/*.step
parts/*.3mf
